{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pong-live",
  "compatibility_date": "2026-08-28",
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "PongRoom" }
    ]
  },
  "exports": {
    "PongRoom": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "pong.gelolaus.com", "custom_domain": true }
  ],
  "vars": {
    "PONG_TEST_MODE": "0"
  }
}
